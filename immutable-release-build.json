{
  "schema_version": 2,
  "release_namespace": "releases-v2",
  "python": {
    "package_roots": [
      "acp_adapter",
      "agent",
      "cron",
      "gateway",
      "hermes_cli",
      "plugins",
      "providers",
      "tools",
      "tui_gateway"
    ],
    "module_files": [
      "run_agent.py",
      "model_tools.py",
      "toolsets.py",
      "batch_runner.py",
      "trajectory_compressor.py",
      "toolset_distributions.py",
      "cli.py",
      "hermes_bootstrap.py",
      "hermes_constants.py",
      "hermes_state.py",
      "hermes_state_common.py",
      "hermes_state_portability.py",
      "hermes_state_schema.py",
      "hermes_state_search.py",
      "hermes_time.py",
      "hermes_logging.py",
      "utils.py",
      "mcp_serve.py"
    ],
    "include_venv_site_packages": true
  },
  "build": {
    "python": {
      "selected_extras": [
        "messaging",
        "honcho",
        "tts-premium",
        "mcp",
        "firecrawl"
      ],
      "target": {
        "python": "3.12",
        "platform": "x86_64-linux-gnu"
      },
      "dependency_sync": [
        "uv",
        "sync",
        "--locked",
        "--no-build",
        "--no-install-project",
        "--no-default-groups",
        "--extra",
        "messaging",
        "--extra",
        "honcho",
        "--extra",
        "tts-premium",
        "--extra",
        "mcp",
        "--extra",
        "firecrawl"
      ],
      "root_build_requirements": [
        {
          "name": "setuptools",
          "version": "83.0.0",
          "source": "uv.lock",
          "wheel_only": true,
          "hash_required": true
        }
      ],
      "root_build_requirement_install": [
        "uv",
        "pip",
        "install",
        "--python",
        ".venv/bin/python",
        "--no-deps",
        "--only-binary",
        ":all:",
        "--require-hashes",
        "--requirements",
        ".aiwerk-root-build-requirements.txt"
      ],
      "root_install": [
        "uv",
        "pip",
        "install",
        "--python",
        ".venv/bin/python",
        "--offline",
        "--no-deps",
        "--no-build-isolation",
        "."
      ],
      "root_build_requirement_remove": [
        "uv",
        "pip",
        "uninstall",
        "--python",
        ".venv/bin/python",
        "setuptools"
      ],
      "root_project": {
        "name": "hermes-agent",
        "version": "0.19.1",
        "source": ".",
        "source_kind": "exact-candidate-tree",
        "required_evidence": [
          "candidate_commit",
          "candidate_tree",
          "METADATA",
          "entry_points.txt",
          "direct_url.json",
          "RECORD",
          "installed_artifact_hashes"
        ]
      }
    },
    "node": [
      "npm",
      "ci",
      "--ignore-scripts"
    ],
    "web": [
      "npm",
      "run",
      "build",
      "--workspace",
      "web"
    ],
    "web_artifact": "hermes_cli/web_dist/index.html",
    "preserve_complete_repository": true,
    "preserve_complete_npm_workspace_graph": true,
    "python_environment": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "UV_COMPILE_BYTECODE": "0",
      "UV_PYTHON_DOWNLOADS": "never"
    },
    "node_environment": {
      "NPM_CONFIG_OMIT": "",
      "NPM_CONFIG_PRODUCTION": "false"
    }
  },
  "closing_gate": {
    "mandatory": true,
    "scenarios": [
      {
        "name": "cli-entry",
        "startup_modules": [
          "hermes_constants"
        ],
        "late_modules": [
          "hermes_cli.main"
        ]
      },
      {
        "name": "dashboard-entry",
        "startup_modules": [
          "hermes_cli.config"
        ],
        "late_modules": [
          "hermes_cli.web_server"
        ]
      },
      {
        "name": "gateway-entry",
        "startup_modules": [
          "gateway.status"
        ],
        "late_modules": [
          "gateway.run"
        ]
      }
    ]
  }
}
